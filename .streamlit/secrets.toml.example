# =============================================================================
#  FinPlay ToDo — konfigurácia
#  Skopíruj tento súbor ako .streamlit/secrets.toml a doplň hodnoty.
#  Všetko je voliteľné: čo nevyplníš, beží v lokálnom / mock režime.
# =============================================================================

[app]
# Minimálny počet krokov, bez ktorých sa úloha nedá uložiť (ADHD rozklad)
min_steps = 3
# Automaticky odoslať e-mailové upozornenia pri načítaní stránky
auto_send_reminders = false
default_timezone = "Europe/Bratislava"

# -----------------------------------------------------------------------------
# Supabase — bez neho appka použije lokálnu SQLite databázu (finplay_local.db)
# -----------------------------------------------------------------------------
[supabase]
url = "https://xxxxxxxxxxxx.supabase.co"
anon_key = "eyJhbGciOi..."
# service_role_key = "eyJhbGciOi..."   # nepovinné, len pre servisné úlohy

# -----------------------------------------------------------------------------
# AI modely — každý je nezávislý, chýbajúci kľúč = model sa preskočí
# -----------------------------------------------------------------------------
[ai.anthropic]
api_key = "sk-ant-..."
model = "claude-opus-5"

[ai.gemini]
api_key = "AIza..."
model = "gemini-2.5-pro"

[ai.openai]
api_key = "sk-..."
model = "gpt-4o"

# -----------------------------------------------------------------------------
# SMTP — zdieľanie taskov e-mailom a upozornenia
# -----------------------------------------------------------------------------
[smtp]
host = "smtp.gmail.com"
port = 587
username = "ty@firma.sk"
password = "app-password"          # Gmail: App Password, nie bežné heslo
from_email = "ty@firma.sk"
from_name = "FinPlay ToDo"
use_tls = true
use_ssl = false

# -----------------------------------------------------------------------------
# Google Calendar — Google Cloud Console → OAuth 2.0 Client ID (Web application)
# Redirect URI pridaj presne takto:  http://localhost:8501
# -----------------------------------------------------------------------------
[google]
client_id = "xxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
redirect_uri = "http://localhost:8501"
calendar_id = "primary"

# -----------------------------------------------------------------------------
# Microsoft To Do — Azure Portal → App registrations
# API permissions: Tasks.ReadWrite, User.Read, offline_access (delegated)
# Redirect URI (typ Web):  http://localhost:8501
# -----------------------------------------------------------------------------
[microsoft]
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "..."
tenant = "common"
redirect_uri = "http://localhost:8501"
todo_list_name = "FinPlay ToDo"
